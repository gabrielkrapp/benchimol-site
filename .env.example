NEXT_PUBLIC_SITE_URL=https://clinicadeolhosbenchimol.com.br
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Private server signer for short-lived media URLs; also trusted manual scripts.
# Prefer Supabase secret key for runtime. Never prefix either key with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Optional private certificate file for a verified remote PostgreSQL TLS chain.
SUPABASE_DB_CA_FILE=
SUPABASE_CLINIC_PROJECT_REF=
# Initial public archive works without Supabase. Set false once the live backend
# is required, so missing configuration cannot bring the old archive back.
ALLOW_PUBLIC_SNAPSHOT=true
# Recovery UI remains disabled until real SMTP/redirect delivery is validated.
AUTH_RECOVERY_ENABLED=false
# Random server-only secret for distributed login throttling. At least 32 chars.
LOGIN_RATE_SECRET=
